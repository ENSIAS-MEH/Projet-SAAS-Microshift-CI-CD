pipeline {
    agent any
    environment {
        DOCKER_IMAGE = 'dev-build'
        PUBLISH_IMAGE = 'publish.build'
        DOCKER_TAG = "${env.BUILD_NUMBER}" 
        REGISTRY_ADDRESS = "localhost:5000"
        SONAR_TOKEN = credentials('sonar-token-id')
    }
    stages {
        stage('unit tests') {
            steps {
                dir('Application') {
                    sh "mvn test"
                }
            }
            post {
                always {
                    junit '**/target/surefire-reports/*.xml'
                }
            }
        }

        stage('dependency scan') {
            steps {
                dir('Application') {
                    sh "mvn org.owasp:dependency-check-maven:check"
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'Application/target/dependency-check-report.html', allowEmptyArchive: true
                }
            }
        }
        stage('build') {
            steps {
                sh "docker compose -f Application/src/CI/docker-compose.yml build"            }
        }
        stage('tag & push') {
            steps {
                sh """
                    docker tag ${DOCKER_IMAGE}:${DOCKER_TAG} ${REGISTRY_ADDRESS}/${PUBLISH_IMAGE}:${DOCKER_TAG}
                    docker push ${REGISTRY_ADDRESS}/${PUBLISH_IMAGE}:${DOCKER_TAG}
                """
            }
        }
        stage('sonarqube') {
            steps {
                dir('Application') {
                    sh """
                        mvn compile sonar:sonar \
                        -Dsonar.projectKey=factorysaas \
                        -Dsonar.host.url=http://localhost:9000 \
                        -Dsonar.login=${SONAR_TOKEN}
                    """
                }
            }
        }
        stage('security scans') {
            steps {
                
                sh "docker pull ${REGISTRY_ADDRESS}/${PUBLISH_IMAGE}:${DOCKER_TAG}"
                sh "docker run --rm -v /var/run/docker.sock:/var/run/docker.sock aquasec/trivy image --exit-code 1 --severity HIGH,CRITICAL localhost:5000/publish.build:${DOCKER_TAG}"
                sh "docker scout cves localhost:5000/publish.build:${DOCKER_TAG}"
            }
        }
    }
}